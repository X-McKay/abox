# AppArmor profile for virtiofsd as used by abox.
#
# virtiofsd is a FUSE/virtio-fs daemon that exposes a host directory to a
# guest VM via a Unix socket. In the abox threat model, virtiofsd runs on
# the host and is the primary boundary between the host filesystem and the
# guest. A virtiofsd vulnerability or misconfiguration could allow the guest
# to read or write host files outside the intended shared directory.
#
# This profile confines virtiofsd to:
#   - The specific shared directory it is serving (read-only for meta/status,
#     read-write for the workspace worktree).
#   - The Unix socket path it listens on.
#   - The minimal set of capabilities required for user-namespace sandboxing.
#
# Installation (one-time, run as root):
#   sudo cp apparmor/usr.bin.virtiofsd /etc/apparmor.d/
#   sudo apparmor_parser -r /etc/apparmor.d/usr.bin.virtiofsd
#
# To verify the profile is loaded:
#   sudo aa-status | grep virtiofsd
#
# NOTE: This profile uses variables for the shared-dir and socket paths.
# In production, these should be set to the actual runtime directory used
# by abox (default: /run/abox or ~/.abox/run). Adjust @{ABOX_RUNTIME_DIR}
# and @{ABOX_STATE_DIR} below to match your deployment.

# Adjust these variables to match your abox runtime and state directories.
@{ABOX_RUNTIME_DIR}=/run/abox /tmp/abox-*
@{ABOX_STATE_DIR}=@{HOME}/.abox /var/lib/abox

# The profile name matches the resolved binary path. If virtiofsd is
# installed at a non-standard location (e.g. ~/.abox/vm/virtiofsd),
# add that path as an additional profile name or use a hat.
profile virtiofsd /usr/bin/virtiofsd {
  #include <abstractions/base>

  # ── Capabilities ──────────────────────────────────────────────────────────
  # CAP_SYS_ADMIN is required for unshare(CLONE_NEWUSER | CLONE_NEWNS) when
  # running with --sandbox=namespace. On kernels with unprivileged user
  # namespaces enabled (sysctl kernel.unprivileged_userns_clone=1, the default
  # on most distributions), this capability is NOT required. If your kernel
  # requires it, uncomment the line below.
  # capability sys_admin,

  # CAP_DAC_OVERRIDE is NOT granted. virtiofsd must run as the same UID as
  # the shared directory owner. The abox adapter ensures this by passing
  # --uid-map/:1000:<host-uid>:1: so the guest UID 1000 maps to the host
  # user's UID, not root.

  # ── Filesystem access ─────────────────────────────────────────────────────
  # Allow read of /proc/self for UID/GID detection (used by the adapter).
  /proc/self/       r,
  /proc/self/status r,

  # Allow access to /dev/fuse (required for FUSE operations).
  /dev/fuse rw,

  # Allow virtiofsd to read its own binary.
  /usr/bin/virtiofsd r,
  # Also allow installs from the abox state directory.
  @{ABOX_STATE_DIR}/vm/virtiofsd r,

  # Allow virtiofsd to create and listen on its Unix socket.
  @{ABOX_RUNTIME_DIR}/*.sock rw,
  @{ABOX_RUNTIME_DIR}/ rw,

  # Allow access to the shared directories virtiofsd serves.
  # The workspace share is read-write; meta and status are effectively
  # read-only from the host's perspective (the guest writes exit-code to
  # status, but that directory is pre-created by the adapter).
  @{ABOX_RUNTIME_DIR}/meta-*/ r,
  @{ABOX_RUNTIME_DIR}/meta-*/** rw,
  @{ABOX_RUNTIME_DIR}/status-*/ r,
  @{ABOX_RUNTIME_DIR}/status-*/** rw,

  # Workspace worktrees live under the abox state directory.
  # The pattern below covers ~/.abox/worktrees/<task-id>/**
  @{ABOX_STATE_DIR}/worktrees/ r,
  @{ABOX_STATE_DIR}/worktrees/*/ r,
  @{ABOX_STATE_DIR}/worktrees/**  rw,

  # ── Network ───────────────────────────────────────────────────────────────
  # virtiofsd communicates only via Unix sockets (FUSE over virtio).
  # No network access is required or permitted.
  deny network inet,
  deny network inet6,

  # ── Explicit denies ───────────────────────────────────────────────────────
  # Prevent virtiofsd from reading sensitive host paths even if a bug
  # allows path traversal out of the shared directory.
  deny /etc/shadow r,
  deny /etc/sudoers r,
  deny /root/** r,
  deny /proc/*/mem rw,
  deny /proc/sysrq-trigger rw,
  deny /sys/kernel/security/** rw,
}

# Alternative profile name for installs from the abox state directory.
# This is a hat (sub-profile) that inherits the parent's rules and adds
# the non-standard binary path.
profile virtiofsd_abox_install @{ABOX_STATE_DIR}/vm/virtiofsd {
  #include <abstractions/base>

  /dev/fuse rw,
  @{ABOX_STATE_DIR}/vm/virtiofsd r,
  @{ABOX_RUNTIME_DIR}/*.sock rw,
  @{ABOX_RUNTIME_DIR}/ rw,
  @{ABOX_RUNTIME_DIR}/meta-*/ r,
  @{ABOX_RUNTIME_DIR}/meta-*/** rw,
  @{ABOX_RUNTIME_DIR}/status-*/ r,
  @{ABOX_RUNTIME_DIR}/status-*/** rw,
  @{ABOX_STATE_DIR}/worktrees/ r,
  @{ABOX_STATE_DIR}/worktrees/*/ r,
  @{ABOX_STATE_DIR}/worktrees/** rw,

  /proc/self/       r,
  /proc/self/status r,

  deny network inet,
  deny network inet6,
  deny /etc/shadow r,
  deny /etc/sudoers r,
  deny /root/** r,
  deny /proc/*/mem rw,
}
